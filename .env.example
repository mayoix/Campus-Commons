# Copy this file to .env. Never commit the real .env file.
# The URL is visible in the Supabase project Connect dialog.
SUPABASE_URL=https://your-project-ref.supabase.co

# Server-only key. Use the new sb_secret_... key when available.
# The legacy service_role key is also accepted by this local MVP.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Optional: change the private evidence bucket name.
SUPABASE_EVIDENCE_BUCKET=campus-evidence

# Shared business database. Copy the exact URI from Supabase Connect and
# replace the password placeholder; do not commit the real value.
SUPABASE_DATABASE_URL=postgresql://postgres.your-project-ref:YOUR_DATABASE_PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres

# Optional local settings.
# PORT=8765
# CAMPUS_DB_PATH=/persistent/path/campus_commons.sqlite3
