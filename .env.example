# Copy this file to .env. Never commit the real .env file.
# The URL is visible in the Supabase project Connect dialog.
SUPABASE_URL=https://your-project-ref.supabase.co

# Server-only key. Use the new sb_secret_... key when available.
# The legacy service_role key is also accepted by this local MVP.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Optional: change the private evidence bucket name.
SUPABASE_EVIDENCE_BUCKET=campus-evidence

# Shared business database. Copy the exact URI from Supabase Connect and
# replace the password placeholder; do not commit the real value.
SUPABASE_DATABASE_URL=postgresql://postgres.your-project-ref:YOUR_DATABASE_PASSWORD@YOUR_SESSION_POOLER_HOST:5432/postgres?sslmode=verify-full&sslrootcert=system

# Fail clearly if the cloud DSN is missing rather than silently using SQLite.
CAMPUS_DB_BACKEND=supabase

# Optional for double-click startup: if omitted, the launcher generates a
# local password in .launcher-admin-password. For direct server.py startup,
# set a new private password; never use the historical .admin-password.
# CAMPUS_ADMIN_PASSWORD=replace_with_a_new_private_admin_password

# Optional local settings.
PORT=8765
# CAMPUS_DB_PATH=/persistent/path/campus_commons.sqlite3
